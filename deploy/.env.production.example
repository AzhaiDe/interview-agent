NODE_ENV=production
# Current IP-only deployment uses HTTP. Change this to true after HTTPS is
# enabled on the public endpoint.
COOKIE_SECURE=false
MODEL_ENABLED=true
BAILIAN_API_KEY=replace-me
MODEL_FAST=qwen3.7-plus
MODEL_STANDARD=qwen3.7-plus
MODEL_REASONING=qwen3.7-plus
OMNIMEMORY_ENABLED=false
OMNIMEMORY_WRITE_ENABLED=false
LOCAL_USER_ID=local-user

# Database migration. Keep sqlite during Shadow; switch only after data parity.
DATABASE_DRIVER=sqlite
POSTGRES_DB=offerpilot
POSTGRES_USER=offerpilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://offerpilot:replace-with-a-long-random-password@postgres:5432/offerpilot

# Graph migration. legacy is the safe default until Shadow acceptance passes.
INTERVIEW_GRAPH_ENGINE=legacy
