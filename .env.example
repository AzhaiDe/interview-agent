NODE_ENV=development
PORT=4310
DATA_DIR=./data-v2
DATABASE_PATH=./data-v2/offerpilot.sqlite
UPLOAD_DIR=./data-v2/uploads
LOCAL_USER_ID=local-user
WORKER_CONCURRENCY=3
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
OCR_MAX_PAGES=8

# Alibaba Cloud Model Studio / Bailian
MODEL_ENABLED=true
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_FAST=qwen3.7-plus
MODEL_STANDARD=qwen3.7-plus
MODEL_REASONING=qwen3.7-plus
MODEL_TIMEOUT_MS=45000

# OmniMemory v2 Router API
OMNIMEMORY_ENABLED=true
OMNIMEMORY_WRITE_ENABLED=true
OMNIMEMORY_API_KEY=
OMNIMEMORY_API_BASE_URL=https://api.omnimemory.cn/api/v2
OMNIMEMORY_TIMEOUT_MS=12000
OMNIMEMORY_POLL_MS=15000
