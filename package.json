{
  "name": "pressure-interview-agent",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "eval:validate": "node evals/scripts/validate.mjs",
    "eval:run": "tsx evals/scripts/run-silver.ts",
    "eval:score": "node evals/scripts/score.mjs",
    "public:demo": "bash scripts/public-demo.sh",
    "kb:build": "node knowledge-base/scripts/build.mjs",
    "kb:validate": "node knowledge-base/scripts/validate.mjs",
    "kb:judge": "node knowledge-base/scripts/judge.mjs",
    "kb:promote": "node knowledge-base/scripts/promote.mjs",
    "eval:expand": "node evals/scripts/expand-silver.mjs",
    "eval:collect": "node evals/scripts/collect-trajectories.mjs",
    "eval:gold": "node evals/scripts/generate-gold-candidates.mjs",
    "eval:gold:static": "tsx evals/eval-runner.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.0.3",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.3.3",
    "file-type": "^22.0.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^6.2.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
